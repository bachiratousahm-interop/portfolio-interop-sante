          <com.mirth.connect.plugins.javascriptstep.JavaScriptStep version="4.5.2">
            <sequenceNumber>0</sequenceNumber>
            <enabled>true</enabled>
            <script>// === Lecture du segment OBX ===
var setId = msg[&apos;OBX&apos;][&apos;OBX.1&apos;].toString();
var valueType = msg[&apos;OBX&apos;][&apos;OBX.2&apos;].toString();
var loincCode = msg[&apos;OBX&apos;][&apos;OBX.3&apos;][&apos;OBX.3.1&apos;].toString();
var loincDisplay = msg[&apos;OBX&apos;][&apos;OBX.3&apos;][&apos;OBX.3.2&apos;].toString();
var observationValue = msg[&apos;OBX&apos;][&apos;OBX.5&apos;].toString();
var units = msg[&apos;OBX&apos;][&apos;OBX.6&apos;][&apos;OBX.6.1&apos;].toString();
var refRange = msg[&apos;OBX&apos;][&apos;OBX.7&apos;][&apos;OBX.7.1&apos;].toString();
var abnormalFlag = msg[&apos;OBX&apos;][&apos;OBX.8&apos;][&apos;OBX.8.1&apos;].toString();
var resultStatus = msg[&apos;OBX&apos;][&apos;OBX.11&apos;][&apos;OBX.11.1&apos;].toString();
// === Lecture de l&apos;IPP patient (segment PID, comme dans les scripts précédents) ===
var ipp = msg[&apos;PID&apos;][&apos;PID.3&apos;][&apos;PID.3.1&apos;].toString();

// === Conversion du statut HL7 -&gt; FHIR ===
var statusFHIR = (resultStatus == &apos;F&apos;) ? &apos;final&apos; :
                  (resultStatus == &apos;P&apos;) ? &apos;preliminary&apos; :
                  (resultStatus == &apos;C&apos;) ? &apos;corrected&apos; : &apos;unknown&apos;;

// === Découpage de la plage de référence (ex: &quot;13.0-17.0&quot;) ===
var rangeParts = refRange.split(&apos;-&apos;);
var rangeLow = rangeParts[0];
var rangeHigh = rangeParts[1];

// === Conversion du flag d&apos;anomalie HL7 -&gt; FHIR (table v3-ObservationInterpretation) ===
var interpretationFHIR = (abnormalFlag == &apos;N&apos;) ? &apos;N&apos; :
                          (abnormalFlag == &apos;H&apos;) ? &apos;H&apos; :
                          (abnormalFlag == &apos;L&apos;) ? &apos;L&apos; : &apos;A&apos;;

// === Construction de la ressource Observation ===
var observationFHIR = {
    resourceType: &quot;Observation&quot;,
    status: statusFHIR,
    code: {
        coding: [{
            system: &quot;http://loinc.org&quot;,
            code: loincCode,
            display: loincDisplay
        }]
    },
    subject: {
        reference: &quot;Patient?identifier=&quot; + ipp
    },
    valueQuantity: {
        value: parseFloat(observationValue),
        unit: units,
        system: &quot;http://unitsofmeasure.org&quot;,
        code: units
    },
    referenceRange: [{
        low: { value: parseFloat(rangeLow) },
        high: { value: parseFloat(rangeHigh) }
    }],
    interpretation: [{
        coding: [{
            system: &quot;http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation&quot;,
            code: interpretationFHIR
        }]
    }]
};

// === Construction du Bundle Transaction (nécessaire pour la référence conditionnelle) ===
var bundleFHIR = {
    resourceType: &quot;Bundle&quot;,
    type: &quot;transaction&quot;,
    entry: [
        {
            resource: observationFHIR,
            request: { method: &quot;POST&quot;, url: &quot;Observation&quot; }
        }
    ]
};

// === Stockage pour la Destination ===
channelMap.put(&apos;fhirObservationJSON&apos;, JSON.stringify(bundleFHIR));</script>
          </com.mirth.connect.plugins.javascriptstep.JavaScriptStep>
