          <com.mirth.connect.plugins.javascriptstep.JavaScriptStep version="4.5.2">
            <sequenceNumber>0</sequenceNumber>
            <enabled>true</enabled>
            <script>// Lecture des champs HL7 v2 (segment PID)
var ipp = msg[&apos;PID&apos;][&apos;PID.3&apos;][&apos;PID.3.1&apos;].toString();
var nom = msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.1&apos;].toString();
var prenom = msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.2&apos;].toString();
var dateNaissanceHL7 = msg[&apos;PID&apos;][&apos;PID.7&apos;][&apos;PID.7.1&apos;].toString();
var sexeHL7 = msg[&apos;PID&apos;][&apos;PID.8&apos;][&apos;PID.8.1&apos;].toString();

// Conversion date AAAAMMJJ -&gt; AAAA-MM-JJ (format FHIR)
var dateNaissanceFHIR = dateNaissanceHL7.substring(0,4) + &apos;-&apos; + dateNaissanceHL7.substring(4,6) + &apos;-&apos; + dateNaissanceHL7.substring(6,8);

// Conversion du genre HL7 (M/F) -&gt; FHIR (male/female)
var genreFHIR = (sexeHL7 == &apos;M&apos;) ? &apos;male&apos; : (sexeHL7 == &apos;F&apos;) ? &apos;female&apos; : &apos;unknown&apos;;

// Construction de la ressource FHIR Patient
var patientFHIR = {
    resourceType: &quot;Patient&quot;,
    identifier: [{
        system: &quot;https://fhir-sainte-marie.up.railway.app/identifiers/ipp&quot;,
        value: ipp
    }],
    name: [{
        family: nom,
        given: [prenom]
    }],
    birthDate: dateNaissanceFHIR,
    gender: genreFHIR
};

// Stockage du JSON FHIR dans une variable de canal, réutilisable dans la Destination
channelMap.put(&apos;fhirPatientJSON&apos;, JSON.stringify(patientFHIR));</script>
          </com.mirth.connect.plugins.javascriptstep.JavaScriptStep>
